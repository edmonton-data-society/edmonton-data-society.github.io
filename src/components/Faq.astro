---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-stone-200 dark:divide-stone-800">
  {
    items.map((item) => (
      <details class="group py-4">
        <summary class="text-ink flex cursor-pointer list-none items-center justify-between gap-4 font-medium dark:text-white">
          {item.question}
          <span
            aria-hidden="true"
            class="text-accent text-xl transition-transform group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="mt-3 text-sm">{item.answer}</p>
      </details>
    ))
  }
</div>
