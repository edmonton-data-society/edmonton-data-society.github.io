---
import { LINKS, NAV, SITE } from '../consts';

const path = Astro.url.pathname;
---

<header class="border-b border-stone-200 dark:border-stone-800">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-6 py-4">
    <a href="/" class="shrink-0" aria-label={`${SITE.name} home`}>
      <img src="/logo.png" alt={SITE.name} width="1292" height="608" class="h-9 w-auto" />
    </a>

    <nav aria-label="Main" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}
            class="hover:text-accent aria-[current=page]:text-accent aria-[current=page]:underline-offset-4 aria-[current=page]:underline"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={LINKS.discord}
      class="bg-brand-700 hover:bg-brand-800 ml-auto rounded-full px-5 py-2 text-sm font-medium text-white transition-colors"
    >
      Join our Discord
    </a>
  </div>
</header>
