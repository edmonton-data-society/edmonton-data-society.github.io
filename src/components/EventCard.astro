---
interface Props {
  title: string;
  date: Date;
  location: string;
  summary: string;
  speaker?: string;
  rsvpUrl?: string;
}

const { title, date, location, summary, speaker, rsvpUrl } = Astro.props;

const formatted = new Intl.DateTimeFormat('en-CA', {
  dateStyle: 'full',
  timeStyle: 'short',
  timeZone: 'America/Edmonton',
}).format(date);
---

<article
  class="rounded-2xl border border-stone-200 bg-white p-6 dark:border-stone-800 dark:bg-stone-900"
>
  <time datetime={date.toISOString()} class="text-accent text-sm font-medium">
    {formatted}
  </time>
  <h3 class="mt-2 text-xl">{title}</h3>
  {speaker && <p class="mt-1 text-sm text-stone-500">with {speaker}</p>}
  <p class="mt-3 text-sm">{summary}</p>
  <p class="mt-4 text-sm text-stone-500">{location}</p>
  {
    rsvpUrl && (
      <a
        href={rsvpUrl}
        class="text-accent hover:text-brand-800 mt-4 inline-block text-sm font-medium underline underline-offset-4"
      >
        RSVP
      </a>
    )
  }
</article>
