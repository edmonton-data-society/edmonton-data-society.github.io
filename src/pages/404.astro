---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="mx-auto max-w-3xl px-6 py-32 text-center">
    <p class="text-accent text-sm font-semibold tracking-widest uppercase">404</p>
    <h1 class="mt-4 text-4xl">We can't find that page</h1>
    <p class="mt-4">It may have moved, or the link may be out of date.</p>
    <a
      href="/"
      class="bg-brand-700 hover:bg-brand-800 mt-8 inline-block rounded-full px-6 py-3 font-medium text-white transition-colors"
    >
      Back home
    </a>
  </div>
</BaseLayout>
