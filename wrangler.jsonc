{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edmonton-data-society",
  "account_id": "b8afda937ec6508da33d0713f213ad85",
  "compatibility_date": "2026-11-23",
  // Assets-only Worker: no `main` script. Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    // Unmatched paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // Custom Domains need an exact hostname match, so www is not listed here:
  // a Cloudflare Redirect Rule sends www.edmontondatasociety.ca to the apex.
  "routes": [
    {
      "pattern": "edmontondatasociety.ca",
      "custom_domain": true
    }
  ]
}
